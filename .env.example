# server
PORT=3001
NODE_ENV=development

# postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab_doc?schema=public

# auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# seed account (used by `pnpm --filter @collab/server seed`)
SEED_USER_EMAIL=demo@collab.dev
SEED_USER_PASSWORD=demo1234
SEED_USER_NAME=Demo

# doc-web
VITE_API_BASE_URL=http://localhost:3001
