# server
PORT=3001
NODE_ENV=development

# postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab_doc?schema=public

# auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# seed accounts (used by `pnpm --filter @wiseflow/server seed`)
SEED_USER_EMAIL=demo@collab.dev
SEED_USER_PASSWORD=demo1234
SEED_USER_NAME=Demo
SEED_SECOND_USER_EMAIL=reviewer@collab.dev
SEED_SECOND_USER_PASSWORD=reviewer1234
SEED_SECOND_USER_NAME=Reviewer

# doc-web
VITE_API_BASE_URL=http://localhost:3001
VITE_COLLAB_WS_URL=ws://localhost:3001/collab
