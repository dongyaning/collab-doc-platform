// Prisma schema for collab-doc-platform M1
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  documents     Document[]      @relation("DocumentOwner")
  memberships   DocumentMember[]
  ownedKbs      KnowledgeBase[] @relation("KbOwner")
  kbMemberships KbMember[]
}

model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  /// Legacy Tiptap JSON. Used as fallback when a doc has no Yjs state yet (M1 docs).
  content   Json     @default("{}")
  /// Latest Yjs document state (binary, encoded via Y.encodeStateAsUpdate).
  yjsState  Bytes?
  /// Monotonic version, bumped on each persisted Yjs snapshot.
  version   Int      @default(0)
  ownerId   String
  owner     User     @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   DocumentMember[]
  versions  DocumentVersion[]

  @@index([ownerId])
  @@index([updatedAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  yjsState    Bytes
  /// User who triggered the snapshot (null = automatic).
  createdById String?
  /// Optional label for manual snapshots.
  label       String?
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model DocumentMember {
  documentId String
  userId     String
  role       DocumentRole @default(VIEWER)
  createdAt  DateTime     @default(now())

  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

// --- Knowledge Base (Wiki / Space) ---

model KnowledgeBase {
  id          String   @id @default(cuid())
  title       String   @default("Untitled")
  description String?

  ownerId     String
  owner       User     @relation("KbOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes       Node[]
  members     KbMember[]

  @@index([ownerId])
  @@index([updatedAt])
}

enum NodeType {
  DOC
  FOLDER
}

model Node {
  id        String   @id @default(cuid())
  kbId      String
  parentId  String?
  type      NodeType @default(DOC)
  title     String   @default("Untitled")
  sortOrder Int      @default(0)

  /// Legacy Tiptap JSON (fallback when no Yjs state).
  content   Json     @default("{}")
  /// Latest Yjs document state.
  yjsState  Bytes?
  /// Monotonic version, bumped on each persisted snapshot.
  version   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kb        KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  parent    Node?         @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]        @relation("NodeTree")

  versions  NodeVersion[]

  @@index([kbId, parentId])
  @@index([kbId, sortOrder])
  @@index([updatedAt])
}

model NodeVersion {
  id          String   @id @default(cuid())
  nodeId      String
  version     Int
  yjsState    Bytes
  createdById String?
  label       String?
  createdAt   DateTime @default(now())

  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([nodeId, createdAt])
}

model KbMember {
  kbId      String
  userId    String
  role      DocumentRole @default(VIEWER)
  createdAt DateTime     @default(now())

  kb        KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kbId, userId])
  @@index([userId])
}
