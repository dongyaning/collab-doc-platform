// Prisma schema for WiseFlow

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

enum AccessRequestScope {
  KNOWLEDGE_BASE
  NODE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String   @default("/uploads/avatars/croodles-atlas.svg")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// The user's default knowledge base (created on registration).
  defaultKbId String?

  ownedKbs               KnowledgeBase[] @relation("KbOwner")
  nodeMembers            NodeMember[]
  accessRequests         AccessRequest[] @relation("AccessRequestRequester")
  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewer")

  @@index([email])
}

// --- Knowledge Base (Wiki / Space) ---

model KnowledgeBase {
  id          String  @id @default(cuid())
  title       String  @default("Untitled")
  description String?

  ownerId String
  owner   User   @relation("KbOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Points to the root Node that represents this KB.
  rootNodeId String? @unique
  rootNode   Node?   @relation("KbRoot", fields: [rootNodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes          Node[]          @relation("KbNodes")
  accessRequests AccessRequest[]

  @@index([ownerId])
  @@index([updatedAt])
}

enum NodeType {
  DOC
  FOLDER
}

model Node {
  id        String   @id @default(cuid())
  kbId      String
  parentId  String?
  type      NodeType @default(DOC)
  title     String   @default("Untitled")
  sortOrder Int      @default(0)

  /// Latest Yjs document state (never null — seeded on creation).
  yjsState Bytes
  /// Monotonic version, bumped on each persisted snapshot.
  version  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kb       KnowledgeBase  @relation("KbNodes", fields: [kbId], references: [id], onDelete: Cascade)
  kbAsRoot KnowledgeBase? @relation("KbRoot") /// The KB this node is the root of (optional).
  parent   Node?          @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Node[]         @relation("NodeTree")

  versions       NodeVersion[]
  members        NodeMember[]
  accessRequests AccessRequest[]

  @@index([kbId, parentId])
  @@index([kbId, sortOrder])
  @@index([updatedAt])
}

model NodeVersion {
  id          String   @id @default(cuid())
  nodeId      String
  version     Int
  yjsState    Bytes
  /// User who triggered the snapshot (null = automatic).
  createdById String?
  /// Optional label for manual snapshots.
  label       String?
  createdAt   DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([nodeId, createdAt])
}

/// Hierarchical permissions: each Node can have its own members.
/// Effective role is resolved by walking up the parent chain.
model NodeMember {
  nodeId          String
  userId          String
  role            NodeRole @default(VIEWER)
  /// Whether this membership also applies to all descendant nodes.
  includeChildren Boolean  @default(false)
  createdAt       DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([nodeId, userId])
  @@index([userId])
}

model AccessRequest {
  id                       String              @id @default(cuid())
  kbId                     String
  nodeId                   String?
  scope                    AccessRequestScope
  requesterId              String
  requestedRole            NodeRole            @default(VIEWER)
  requestedIncludeChildren Boolean             @default(false)
  message                  String?
  status                   AccessRequestStatus @default(PENDING)
  reviewerId               String?
  approvedRole             NodeRole?
  approvedScope            AccessRequestScope?
  approvedNodeId           String?
  approvedIncludeChildren  Boolean?
  reviewedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  kb        KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  node      Node?         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  requester User          @relation("AccessRequestRequester", fields: [requesterId], references: [id])
  reviewer  User?         @relation("AccessRequestReviewer", fields: [reviewerId], references: [id])

  @@index([kbId, status])
  @@index([nodeId])
  @@index([requesterId, status])
}

/// Uploaded file metadata.
model FileStorage {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  /// Storage driver: "local" or "s3".
  storageType  String   @default("local")
  /// Relative storage path (e.g. "2026/07/06/uuid.ext") or S3 object key.
  storagePath  String
  /// Publicly accessible URL.
  url          String
  /// Optional: which node the file is attached to.
  nodeId       String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([nodeId])
  @@index([uploadedById])
}

model MonitorEvent {
  id           String   @id @default(cuid())
  eventId      String   @unique
  app          String
  eventType    String
  name         String
  status       String?
  value        Float?
  duration     Int?
  userId       String?
  anonymousId  String?
  sessionId    String?
  pageViewId   String?
  traceId      String?
  route        String?
  docId        String?
  url          String?
  method       String?
  statusCode   Int?
  errorMessage String?
  metadata     Json?
  userAgent    String?
  browser      String?
  os           String?
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@index([app, createdAt])
  @@index([eventType, createdAt])
  @@index([docId, createdAt])
  @@index([traceId])
  @@index([sessionId])
  @@index([status, createdAt])
  @@index([duration])
}

// --- Mini Agent Runtime ---

model AgentConversation {
  id                    String    @id @default(cuid())
  userId                String
  kbId                  String
  title                 String    @default("新会话")
  lastMessageAt         DateTime?
  /// 滚动摘要文本，内部上下文，不展示给前端。
  summary               String?
  /// 摘要覆盖到的最后一个 run id。
  summarizedThroughRunId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  runs AgentRun[]

  @@index([userId, kbId, lastMessageAt])
}

enum AgentRunStatus {
  QUEUED
  PREPARING_CONTEXT
  REASONING
  AWAITING_TOOL
  AWAITING_CONFIRMATION
  APPLYING
  COMPLETED
  FAILED
  CANCELLED
  BUDGET_EXHAUSTED
}

enum AgentProposalStatus {
  PENDING
  CONFIRMED
  APPLYING
  APPLIED
  REJECTED
  EXPIRED
  STALE
}

model AgentRun {
  id             String         @id @default(cuid())
  conversationId String
  userId         String
  kbId           String
  nodeId         String?
  status         AgentRunStatus @default(QUEUED)
  message        String
  modelName      String         @default("mock")
  budgetJson     Json?
  /// Accumulated final answer text (streamed tokens concatenated).
  finalAnswer    String?
  steps          Int            @default(0)
  toolCalls      Int            @default(0)
  error          String?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  proposals AgentProposal[]

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@index([kbId, createdAt])
}

model AgentProposal {
  id            String              @id @default(cuid())
  runId         String
  nodeId        String
  /// Node.version at the time the proposal was generated.
  baseVersion   Int
  /// Structured change (JSON: { type, from, to, newText }).
  patch         Json
  /// Doc range the patch targets (optional, for stale detection).
  affectedRange Json?
  status        AgentProposalStatus @default(PENDING)
  confirmedBy   String?
  confirmedAt   DateTime?
  appliedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([nodeId, status])
  @@index([status, expiresAt])
}

/// Agent 生成的动态组件注册表。代码与文档分离：文档 widget 节点只存 widgetType + props。
/// 每个版本一条记录，第一版每组件一版（多版本语义预留）。
model AgentComponent {
  id          String                @id @default(cuid())
  widgetType  String
  kbId        String
  title       String
  version     Int                   @default(1)
  /// TSX 源码。
  sourceCode  String
  /// esbuild 编译产物（自包含 ESM，bundle React），gzip 压缩后存储。
  jsCodeGzip  Bytes
  /// 组件 props 的 JSON Schema，第一版仅存储。
  propsSchema Json?
  status      AgentComponentStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([widgetType, version])
  @@index([kbId, status])
}

enum AgentComponentStatus {
  DRAFT
  ACTIVE
  DISABLED
}
